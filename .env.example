# ─────────────────────────────────────────────────────────────────────────────
# KYNDER — environment variables
#
# Copy to `.env.local` for local dev, or set these in the host dashboard
# (Netlify: Site settings → Environment variables). Every variable is optional
# for a build to SUCCEED, but any left unset renders its "[PENDING: …]" fallback
# and, for the content-checked ones, blocks a PRODUCTION build (see ALLOW_PENDING).
#
# NEXT_PUBLIC_* values are inlined into the client bundle at build time and are
# therefore PUBLIC. Values without that prefix are build-time only (server/CI).
# ─────────────────────────────────────────────────────────────────────────────

# ── Brand / site identity ────────────────────────────────────────────────────
# Site name used in titles, footer and structured data.
NEXT_PUBLIC_SITE_NAME=KYNDER
# Canonical absolute origin (no trailing slash). Drives canonical URLs, the
# sitemap, robots.txt and Open Graph. MUST be the real domain before launch —
# the code falls back to https://example.com, which ships wrong links.
NEXT_PUBLIC_SITE_URL=https://www.example.com
# One-line tagline shown in the footer.
NEXT_PUBLIC_SITE_TAGLINE=
# Footer copyright line, e.g. "© 2026 KYNDER. All rights reserved."
NEXT_PUBLIC_SITE_COPYRIGHT=
# Public contact address; shown in the footer, /contact and the booking fallback.
NEXT_PUBLIC_CONTACT_EMAIL=

# ── Social links (footer). Leave blank to render a plain "[PENDING]" label. ───
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_YOUTUBE=

# ── Booking scheduler (/book) ────────────────────────────────────────────────
# Base URL of the external scheduler embed (e.g. Calendly/SavvyCal). While unset,
# /book shows the honest "booking calendar not yet connected" panel — never a
# fake calendar. The selected topic is passed through as a ?topic= prefill.
# NOTE: also add this origin to the CSP frame-src in netlify.toml when set.
NEXT_PUBLIC_SCHEDULER_URL=

# ── Form endpoints (server-only; NOT exposed to the client) ──────────────────
# Contact form POST target (e.g. a Netlify Function or form service). While unset
# the form validates fully but reports "not connected" — it never fakes success.
# NOTE: add this origin to the CSP connect-src in netlify.toml when set.
FORM_ENDPOINT=
# Newsletter sign-up POST target. Same honest-until-connected behaviour.
# NOTE: add this origin to the CSP connect-src in netlify.toml when set.
NEWSLETTER_ENDPOINT=

# ── Analytics (Plausible) ────────────────────────────────────────────────────
# Registered Plausible domain, e.g. "kynder.coach". While unset, NO analytics
# script is loaded and track() is a safe no-op (honest: analytics not connected).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Optional script src override (self-hosted Plausible or a proxied path).
# Defaults to https://plausible.io/js/script.js.
NEXT_PUBLIC_PLAUSIBLE_SRC=

# ── Build flag ───────────────────────────────────────────────────────────────
# Set to "true" to allow a build while brief copy is still "[PENDING: …]".
# Used for preview/CI builds ONLY. A production build must run WITHOUT it so the
# content-validation gate blocks shipping unresolved placeholders.
# ALLOW_PENDING=true
