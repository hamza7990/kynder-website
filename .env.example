# ─────────────────────────────────────────────────────────────────────────────
# KYNDER — environment variables
#
# Copy to `.env` (or `.env.local`) for local dev, or set these in the host
# dashboard (Vercel: Project → Settings → Environment Variables). This is now a
# server-rendered app: DATABASE_URL and JWT_SECRET are REQUIRED and have no
# insecure defaults — the app fails loudly at startup if they are unset.
#
# NEXT_PUBLIC_* values are inlined into the client bundle at build time and are
# therefore PUBLIC. Values without that prefix are server-only.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Postgres) — REQUIRED ───────────────────────────────────────────
# Connection string for a Neon or Supabase free-tier Postgres database. Read
# from the environment only; there is no fallback. See docs/DATABASE.md for the
# exact steps to create one and point this at it.
#   Neon:     postgresql://USER:PASS@ep-xxx.REGION.aws.neon.tech/DB?sslmode=require
#   Supabase: postgresql://postgres:PASS@db.PROJECT.supabase.co:5432/postgres
DATABASE_URL=

# ── Auth — REQUIRED ──────────────────────────────────────────────────────────
# Secret used to sign session JWTs. Any long random string. If unset the app
# refuses to start. Generate one with: openssl rand -base64 48
JWT_SECRET=

# ── Admin seed account — REQUIRED to run the seed ────────────────────────────
# `npm run db:seed` creates/updates the founder admin account from these. No
# default password ships in the repo.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Brand / site identity ────────────────────────────────────────────────────
# Site name used in titles, footer and structured data.
NEXT_PUBLIC_SITE_NAME=KYNDER
# Canonical absolute origin (no trailing slash). Drives canonical URLs, the
# sitemap, robots.txt and Open Graph. MUST be the real domain before launch —
# the code falls back to https://example.com, which ships wrong links.
NEXT_PUBLIC_SITE_URL=https://www.example.com
# One-line tagline shown in the footer.
NEXT_PUBLIC_SITE_TAGLINE=
# Footer copyright line, e.g. "© 2026 KYNDER. All rights reserved."
NEXT_PUBLIC_SITE_COPYRIGHT=
# Public contact address; shown in the footer, /contact and the booking fallback.
NEXT_PUBLIC_CONTACT_EMAIL=

# ── Social links (footer). Leave blank to render a plain "[PENDING]" label. ───
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_YOUTUBE=

# ── Booking scheduler (/book) — OPTIONAL ─────────────────────────────────────
# While unset, /book shows the built-in DirectBookingForm, which saves bookings
# to the database. Set this to an external scheduler embed (e.g. Calendly) to
# switch /book over to that embed instead. The topic is passed as a ?topic=
# prefill. NOTE: also add this origin to the CSP frame-src in netlify.toml.
NEXT_PUBLIC_SCHEDULER_URL=

# ── Newsletter (footer) — OPTIONAL, server-only ──────────────────────────────
# Newsletter sign-up POST target. While unset the footer form validates but
# honestly reports "not connected". (The contact form no longer uses an external
# endpoint — it saves to the database and is readable at /admin/messages.)
NEWSLETTER_ENDPOINT=

# ── Analytics (Plausible) — OPTIONAL ─────────────────────────────────────────
# Registered Plausible domain, e.g. "kynder.coach". While unset, NO analytics
# script is loaded and track() is a safe no-op (honest: analytics not connected).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Optional script src override (self-hosted Plausible or a proxied path).
# Defaults to https://plausible.io/js/script.js.
NEXT_PUBLIC_PLAUSIBLE_SRC=
