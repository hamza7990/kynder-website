{
  "name": "kynder",
  "version": "0.1.0",
  "private": true,
  "description": "KYNDER leadership-coaching website",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "serve out -l 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
